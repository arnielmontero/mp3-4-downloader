# Copy to .env (never commit .env). All values shown are the defaults.
# docker compose reads this file automatically.

# --- web stack -------------------------------------------------------------------------------
WEB_PORT=8080                       # host port for http://localhost:WEB_PORT
APP_ENV=production
APP_URL=http://localhost:8080       # https://... enables Secure cookies
COOKIE_SECURE=                      # empty = derived from APP_URL

# --- limits ----------------------------------------------------------------------------------
MAX_CONCURRENT_DOWNLOADS=3          # extra jobs wait in the queue
MAX_DOWNLOAD_SIZE_GB=10             # known size above this = rejected; unknown size = stopped when reached
MAX_VIDEO_DURATION_MINUTES=240
DOWNLOAD_TIMEOUT_MINUTES=120        # hard stop for one job
RATE_LIMIT_ANALYZE=20               # requests / window / IP
RATE_LIMIT_DOWNLOAD=5               # new jobs / window / IP
RATE_LIMIT_WINDOW_SECONDS=60

# --- retention -------------------------------------------------------------------------------
DOWNLOAD_RETENTION_HOURS=24         # temp data, failed/cancelled job metadata
COMPLETED_RETENTION_HOURS=0         # 0 = keep finished files until the user deletes them
LOG_RETENTION_DAYS=14

# --- behaviour -------------------------------------------------------------------------------
HISTORY_SCOPE=client                # client = each browser sees only its own history; global = everyone sees all
TRUST_PROXY_HEADERS=false           # true ONLY behind your own reverse proxy (uses X-Forwarded-For for rate limits)
YTDLP_JS_RUNTIME=deno               # JavaScript runtime used by yt-dlp for YouTube (installed in the image)

# --- build-time / resources ------------------------------------------------------------------
YTDLP_VERSION=                      # empty = latest yt-dlp at image build; pin e.g. 2026.08.19
WORKER_CPUS=2.0
WORKER_MEMORY=2G
