{
    "name": "youtube-downloader/backend",
    "description": "REST API + download worker for the YouTube Downloader (CodeIgniter 3)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "codeigniter/framework": "^3.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "application/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "../tests/backend/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
